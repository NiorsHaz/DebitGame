code = "shader_type canvas_item;
render_mode blend_mix;

uniform bool BooleanParameter = false;
uniform vec4 ColorParameter : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);



void vertex() {
// BooleanParameter:4
	bool n_out4p0 = BooleanParameter;


// ColorParameter:2
	vec4 n_out2p0 = ColorParameter;


// Input:3
	vec4 n_out3p0 = COLOR;


	vec3 n_out5p0;
// If:5
	float n_in5p1 = 1.00000;
	float n_in5p2 = 0.00001;
	if(abs((n_out4p0 ? 1.0 : 0.0) - n_in5p1) < n_in5p2)
	{
		n_out5p0 = vec3(n_out2p0.xyz);
	}
	else if((n_out4p0 ? 1.0 : 0.0) < n_in5p1)
	{
		n_out5p0 = vec3(n_out3p0.xyz);
	}
	else
	{
		n_out5p0 = vec3(n_out3p0.xyz);
	}


// Output:0
	COLOR.rgb = n_out5p0;


}
"
